# ==============================================================================
# LLM Test & Benchmark Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Model Selection
# ------------------------------------------------------------------------------
# NOTE: Exactly 1 model lives in 1 Docker container. No CSV lists are accepted.
# To switch models, change TEST_MODEL and restart the stack (docker compose down / up).
TEST_MODEL=qwen2.5-coder:3b

# ------------------------------------------------------------------------------
# 2. Curated Model Options Similar to llama3.2 (~1B - 4B Parameter Class)
# ------------------------------------------------------------------------------
# Uncomment the desired model to test (choose ONE only):

# TEST_MODEL=llama3.2               # Meta Llama 3.2 (3.2B) - Balanced, fast general instruction following
# TEST_MODEL=qwen2.5-coder:3b       # Qwen 2.5 Coder (3.1B) - High-performance code generation
# TEST_MODEL=smollm2:latest         # SmolLM2 (1.7B) - Compact, fast inference
# TEST_MODEL=phi3:mini              # Microsoft Phi-3 Mini (3.8B) - Strong reasoning accuracy
# TEST_MODEL=gemma3:1b              # Google Gemma 3 (1.0B) - Ultra-lightweight edge model
# TEST_MODEL=deepseek-r1:1.5b       # DeepSeek R1 (1.8B) - Reasoning model with thinking traces

# ------------------------------------------------------------------------------
# 3. Connection & Endpoint Settings
# ------------------------------------------------------------------------------
# Ollama Direct Host (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Backend type: 'ollama' (recommended, direct & fast)
LLM_ENDPOINT=ollama

# Questions XML suite path (file, directory, or glob pattern)
QUESTIONS_FILE=Questions/*.xml

# Output directory for timestamped test metrics
METRICS_DIR=Test metrics
