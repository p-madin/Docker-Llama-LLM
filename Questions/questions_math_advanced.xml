    <test_case id="math-sum-arithmetic-progression" tier="2" category="discrete_math" difficulty="medium">
        <name>Sum of Arithmetic Progression</name>
        <question>What is the sum of the integers from 1 to 20 inclusive? (1 + 2 + 3 + ... + 20)</question>
