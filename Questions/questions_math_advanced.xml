    <!-- Test Case 12: Quadratic Discriminant and Real Roots -->
    <test_case id="math-quadratic-roots-discriminant" tier="2" category="discrete_math" difficulty="medium">
        <name>Quadratic Discriminant and Real Roots</name>
        <question>For the quadratic equation 2x^2 + 4x + 5 = 0, what is the numerical value of the discriminant (b^2 - 4ac), and how many real roots does the equation possess?</question>
        <system_prompt>You are an algebra assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>-24</expected>
                <expected>negative 24</expected>
            </assert>
            <assert type="contains_any" case_sensitive="false">
                <expected>0 real</expected>
                <expected>zero real</expected>
                <expected>no real</expected>
                <expected>none</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 13: Set Intersection Cardinality -->
    <test_case id="math-set-intersection-cardinality" tier="1" category="discrete_math" difficulty="easy">
        <name>Set Intersection Cardinality</name>
        <question>Given Set A = {1, 3, 5, 7, 9} and Set B = {3, 6, 9, 12}, what is the cardinality of the intersection set (A ∩ B)?</question>
        <system_prompt>You are a set theory assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>2</expected>
                <expected>two</expected>
            </assert>
        </assertions>
    </test_case>

