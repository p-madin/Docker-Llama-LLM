    <!-- Test Case 11: Cube Root of 216 -->
    <test_case id="math-cube-root-216" tier="1" category="discrete_math" difficulty="easy">
        <name>Cube Root Calculation</name>
        <question>What is the exact cube root of 216? Give only the integer.</question>
        <system_prompt>You are an arithmetic assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
