<?xml version="1.0" encoding="UTF-8"?>
<test_suite name="Advanced Deterministic Mathematics Suite">
    <!-- Test Case 1: Modular Arithmetic Remainder -->
    <test_case id="math-modular-arithmetic-remainder" tier="2" category="discrete_math" difficulty="medium">
        <name>Modular Exponentiation Remainder</name>
        <question>What is the remainder when 17^3 is divided by 5 (i.e. 17^3 mod 5)? State the single integer remainder.</question>
        <system_prompt>You are a discrete math assistant. State the exact numeric result.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>3</expected>
                <expected>three</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 2: Hexadecimal to Decimal Conversion -->
    <test_case id="math-base-hex-to-dec" tier="1" category="discrete_math" difficulty="easy">
        <name>Hexadecimal to Decimal Base Conversion</name>
        <question>Convert the hexadecimal number 0x2F into its base-10 decimal equivalent. Give only the decimal number.</question>
        <system_prompt>You are a precise number conversion assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>47</expected>
                <expected>forty-seven</expected>
                <expected>forty seven</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 3: Binary to Decimal Conversion -->
    <test_case id="math-base-bin-to-dec" tier="1" category="discrete_math" difficulty="easy">
        <name>Binary to Decimal Base Conversion</name>
        <question>Convert the 8-bit binary number 10110000 into its base-10 decimal equivalent. Give only the decimal number.</question>
        <system_prompt>You are a precise number conversion assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>176</expected>
                <expected>one hundred seventy-six</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 4: Combinatorics Handshake Problem -->
    <test_case id="math-combinatorics-handshakes" tier="2" category="discrete_math" difficulty="medium">
        <name>Combinatorics Handshake Problem</name>
        <question>If there are 8 people in a room and every person shakes hands with every other person exactly once, how many total handshakes occur?</question>
        <system_prompt>You are a combinatorics mathematician.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>28</expected>
                <expected>twenty-eight</expected>
                <expected>twenty eight</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 5: Pigeonhole Principle Sock Selection -->
    <test_case id="math-pigeonhole-socks" tier="2" category="discrete_math" difficulty="medium">
        <name>Pigeonhole Principle Sock Selection</name>
        <question>A drawer contains 10 black socks and 10 white socks in total darkness. What is the minimum number of socks you must pull out to guarantee you have at least one matching pair?</question>
        <system_prompt>You are a discrete math assistant applying the pigeonhole principle.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>3</expected>
                <expected>three</expected>
            </assert>
        </assertions>
    </test_case>

    <!-- Test Case 6: Prime Factorization of 84 -->
    <test_case id="math-prime-factorization-84" tier="1" category="discrete_math" difficulty="easy">
        <name>Prime Factorization of 84</name>
        <question>What is the prime factorization of 84? Express as a product of prime powers (e.g. 2^2 * 3 * 7).</question>
        <system_prompt>You are an arithmetic assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>2^2 * 3 * 7</expected>
                <expected>2^2 * 3^1 * 7^1</expected>
                <expected>2 * 2 * 3 * 7</expected>
                <expected>2^2 × 3 × 7</expected>
                <expected>2² * 3 * 7</expected>
                <expected>2² × 3 × 7</expected>
                <expected>2^2 · 3 · 7</expected>
            </assert>
        </assertions>
    </test_case>

