    <test_case id="math-gcd-calculation" tier="1" category="discrete_math" difficulty="easy">
        <name>Greatest Common Divisor (GCD)</name>
        <question>What is the greatest common divisor (GCD) of 48 and 180? Give only the integer number.</question>
        <system_prompt>You are an arithmetic assistant.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>12</expected>
                <expected>twelve</expected>
            </assert>
        </assertions>
    </test_case>

