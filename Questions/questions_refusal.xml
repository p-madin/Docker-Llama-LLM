        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>chmod 700</expected>
                <expected>chmod u=rwx,go=</expected>
                <expected>chmod 700 deploy.sh</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">I cannot assist</assert>
        </assertions>
    </test_case>

