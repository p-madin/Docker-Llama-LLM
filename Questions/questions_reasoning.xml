<?xml version="1.0" encoding="UTF-8"?>
<test_suite name="LLM Reasoning &amp; Deduction Suite">
    <!-- Test Case 1: Invariant Age Difference -->
    <test_case id="reason-age-diff" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Sister Age Invariance</name>
        <question>When I was 6 years old, my sister was half my age. Now I am 70 years old. How old is my sister? State her age clearly.</question>
        <system_prompt>You are a logical reasoning assistant. Think carefully before stating the final answer.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: 70 - 3 = 67. Trap: 70 / 2 = 35 -->
            <assert type="contains">67</assert>
            <assert type="not_contains">35</assert>
        </assertions>
    </test_case>


    <!-- Test Case 3: Transitive Ordering -->
    <test_case id="reason-transitive-order" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Transitive Weight Comparison</name>
        <question>There are three boxes: Red, Green, and Blue. The Red box is heavier than the Green box. The Blue box is lighter than the Green box. Which box is the lightest? Name only the color of the lightest box.</question>
        <system_prompt>You are a deductive reasoning assistant. Deduce the order from heaviest to lightest.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: Blue (Red > Green > Blue). Prohibited: Red, Green as the answer -->
            <assert type="contains" case_sensitive="false">Blue</assert>
            <assert type="not_contains" case_sensitive="false">Red is the lightest</assert>
            <assert type="not_contains" case_sensitive="false">Green is the lightest</assert>
        </assertions>
    </test_case>


    <!-- Test Case 5: Exponential Doubling Rate -->
    <test_case id="reason-lily-pads" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Lily Pad Lake Doubling Rate</name>
        <question>In a lake, there is a patch of lily pads. Every day, the patch doubles in size. If it takes 48 days for the patch to cover the entire lake, how many days would it take for the patch to cover half of the lake? State the number of days.</question>
        <system_prompt>You are a logical reasoning assistant. Work backwards from the full coverage day.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: 47 days. Trap: 24 days (48 / 2 = 24) -->
            <assert type="contains">47</assert>
            <assert type="not_contains" case_sensitive="false">24 days</assert>
        </assertions>
    </test_case>

    <!-- Test Case 6: Algebraic Equation - Brick Weight -->
    <test_case id="reason-brick-weight" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Self-Referential Brick Weight</name>
        <question>A construction brick weighs 1 kilogram plus the weight of half a brick. How many kilograms does one whole brick weigh? State the number of kilograms.</question>
        <system_prompt>You are an algebraic reasoning assistant. Solve for the weight of the whole brick.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: 2 kg (B = 1 + 0.5B => 0.5B = 1 => B = 2). Trap: 1.5 kg (1 + 0.5 = 1.5) -->
            <assert type="contains_any" case_sensitive="false">
                <expected>2 kg</expected>
                <expected>2 kilograms</expected>
                <expected>two kilograms</expected>
                <expected>two kg</expected>
                <expected>weighs 2</expected>
                <expected>weight is 2</expected>
                <expected>equal to 2</expected>
                <expected>is 2</expected>
                <expected>\boxed{2}</expected>
                <expected>x = 2</expected>
                <expected>**2**</expected>
                <expected>W = 2</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">1.5 kg</assert>
            <assert type="not_contains" case_sensitive="false">1.5 kilograms</assert>
        </assertions>
    </test_case>

    <!-- Test Case 7: Round Trip Average Speed (Harmonic Mean) -->
    <test_case id="reason-average-speed" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Round Trip Average Speed</name>
        <question>A car travels from Town A to Town B at 60 mph, and returns along the exact same road from Town B to Town A at 20 mph. What is the car's average speed for the entire round trip in mph? State the number in mph.</question>
        <system_prompt>You are a physics and mathematics assistant. Calculate the harmonic average (total distance divided by total time).</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: 30 mph. Trap: 40 mph ((60 + 20) / 2 = 40) -->
            <assert type="contains_any" case_sensitive="false">
                <expected>30 mph</expected>
                <expected>30 miles per hour</expected>
                <expected>is 30</expected>
                <expected>speed is 30</expected>
                <expected>average speed of 30</expected>
                <expected>\boxed{30}</expected>
                <expected>30</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">is 40 mph</assert>
            <assert type="not_contains" case_sensitive="false">is 40 miles per hour</assert>
            <assert type="not_contains" case_sensitive="false">average speed of 40</assert>
            <assert type="not_contains" case_sensitive="false">\boxed{40}</assert>
        </assertions>
    </test_case>

    <!-- Test Case 8: Deductive Syllogism Validity -->
    <test_case id="reason-syllogism" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Deductive Syllogism Fallacy</name>
        <question>Premise 1: All cats are mammals. Premise 2: Some mammals have tails. Can we logically conclude with certainty that all cats have tails? Answer Yes or No and state your conclusion clearly.</question>
        <system_prompt>You are a formal logic assistant. Analyze whether the conclusion strictly follows from the premises.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: No (cannot conclude). Trap: Yes -->
            <assert type="contains_any" case_sensitive="false">
                <expected>No</expected>
                <expected>cannot conclude</expected>
                <expected>does not follow</expected>
                <expected>invalid</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">Yes, we can conclude</assert>
            <assert type="not_contains" case_sensitive="false">Yes, it follows</assert>
            <assert type="not_contains" case_sensitive="false">conclusion is Yes</assert>
        </assertions>
    </test_case>

    <!-- Test Case 9: Temporal Calendar Reasoning -->
    <test_case id="reason-calendar-day" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Temporal Day Calculation</name>
        <question>If the day before yesterday was Thursday, what day of the week is tomorrow? State only the day of the week.</question>
        <system_prompt>You are a precise deductive reasoning assistant. Calculate step-by-step: day before yesterday -> yesterday -> today -> tomorrow.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: Sunday (Thu -> Fri -> Sat -> Sun). Traps: Saturday, Friday, Monday -->
            <assert type="contains" case_sensitive="false">Sunday</assert>
            <assert type="not_contains" case_sensitive="false">tomorrow is Saturday</assert>
            <assert type="not_contains" case_sensitive="false">tomorrow is Friday</assert>
            <assert type="not_contains" case_sensitive="false">tomorrow is Monday</assert>
        </assertions>
    </test_case>

    <!-- Test Case 10: Simple Probability Ratio -->
    <test_case id="reason-probability" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Urn Probability Calculation</name>
        <question>A bag contains 3 red marbles and 7 blue marbles. If you draw one marble at random, what is the probability that it is red? Express your answer as a decimal or percentage.</question>
        <system_prompt>You are a mathematics assistant. Calculate the ratio of favorable outcomes to total outcomes.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Correct: 3 / (3 + 7) = 0.3 or 30%. Trap: 0.7 or 70% or 3/7 -->
            <assert type="contains_any" case_sensitive="false">
                <expected>0.3</expected>
                <expected>30%</expected>
                <expected>3/10</expected>
                <expected>three tenths</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">0.7</assert>
            <assert type="not_contains" case_sensitive="false">70%</assert>
            <assert type="not_contains" case_sensitive="false">3/7</assert>
        </assertions>
    </test_case>

    <!-- Test Case 11: Deductive Logic - Knights and Knaves -->
    <test_case id="reason-knights-knaves" tier="2" category="multi_step_reasoning" difficulty="medium">
        <name>Knights and Knaves (Both Knaves Statement)</name>
        <question>On an island, inhabitants are either Knights (who always tell the truth) or Knaves (who always lie). You meet two inhabitants, A and B. A makes the statement: "We are both knaves." What are the true identities of A and B? State whether A is a knight or knave, and whether B is a knight or knave.</question>
        <system_prompt>You are a formal logic assistant. Analyze whether A's statement can be true or false, then deduce the identities of A and B.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <!-- Must identify A as a knave -->
            <assert type="contains_any" case_sensitive="false">
                <expected>A is a knave</expected>
                <expected>A is the knave</expected>
                <expected>A is a Knave</expected>
                <expected>A: knave</expected>
                <expected>A: Knave</expected>
                <expected>A is knave</expected>
                <expected>A must be a knave</expected>
                <expected>A is indeed a knave</expected>
            </assert>
            <!-- Must identify B as a knight -->
            <assert type="contains_any" case_sensitive="false">
                <expected>B is a knight</expected>
                <expected>B is the knight</expected>
                <expected>B is a Knight</expected>
                <expected>B: knight</expected>
                <expected>B: Knight</expected>
                <expected>B is knight</expected>
                <expected>B must be a knight</expected>
                <expected>B is indeed a knight</expected>
            </assert>
            <!-- Prohibit invalid mutual identities (avoiding premise leakage of quoting 'both are knaves') -->
            <assert type="not_contains" case_sensitive="false">both are knights</assert>
        </assertions>
    </test_case>

    <!-- Test Case 12: Practical Engineering Reasoning - River Crossing Structure -->
    <test_case id="reason-river-crossing-structure" tier="1" category="multi_step_reasoning" difficulty="easy">
        <name>River Crossing Structure Selection</name>
        <question>What structure could facilitate safer, faster travel between two points separated by a deep river 10 metres wide?</question>
        <system_prompt>Answer concisely identifying the structure. Do not suggest vehicles, boats, or floating craft.</system_prompt>
        <temperature>0.0</temperature>
        <assertions>
            <assert type="contains_any" case_sensitive="false">
                <expected>bridge</expected>
                <expected>tunnel</expected>
                <expected>underwater tunnel</expected>
                <expected>dam</expected>
                <expected>causeway</expected>
                <expected>footbridge</expected>
            </assert>
            <assert type="not_contains" case_sensitive="false">boat</assert>
            <assert type="not_contains" case_sensitive="false">drain</assert>
            <assert type="not_contains" case_sensitive="false">floating</assert>
        </assertions>
    </test_case>
</test_suite>
