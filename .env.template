# ------------------------------------------------------------------------------
# 3. Connection & Endpoint Settings
# ------------------------------------------------------------------------------
# Ollama Direct Host (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Backend type: 'ollama' (recommended, direct & fast), 'gemini', or 'openai'/'openwebui'
LLM_ENDPOINT=ollama
# Google Gemini API Key (Required when testing Gemini models e.g. gemini-2.0-flash, gemini-1.5-pro)
# Use AI Studio key from https://aistudio.google.com/
GEMINI_API_KEY=
# Questions XML suite path (file, directory, or glob pattern)
QUESTIONS_FILE=Questions/*.xml
# Output directory for timestamped test metrics
METRICS_DIR=Test metrics
# Database path for relational SQLite persistence store
DATABASE_PATH=benchmark.db

